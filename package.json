{
  "name": "faforever-rust-client",
  "private": true,
  "version": "2026.10.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "dev": "node scripts/require-pnpm.mjs && vite",
    "build": "node scripts/require-pnpm.mjs && vite build",
    "preview": "node scripts/require-pnpm.mjs && vite preview",
    "lint": "node scripts/require-pnpm.mjs && eslint . --max-warnings 0",
    "architecture": "node scripts/require-pnpm.mjs && node scripts/check-architecture.mjs",
    "i18n:check": "node scripts/require-pnpm.mjs && node scripts/i18n-scan.mjs",
    "i18n:coverage": "node scripts/require-pnpm.mjs && node scripts/i18n-coverage.mjs",
    "typecheck": "node scripts/require-pnpm.mjs && tsc --noEmit",
    "prepare:native": "node scripts/require-pnpm.mjs && node scripts/ensure-faf-uid.mjs && node scripts/ensure-faf-pioneer.mjs && node scripts/ensure-java-runtime.mjs && node scripts/ensure-java-ice-adapter.mjs && node scripts/build-fa-window.mjs",
    "tauri": "node scripts/require-pnpm.mjs && pnpm run prepare:native && tauri",
    "bindings": "node scripts/require-pnpm.mjs && cargo run -q -p faf-ipc --bin export-bindings",
    "icons": "node scripts/require-pnpm.mjs && node scripts/generate-app-icon.mjs",
    "measure:state-sync": "node scripts/require-pnpm.mjs && node scripts/measure-state-sync.mjs",
    "test": "node scripts/require-pnpm.mjs && vitest run",
    "test:watch": "node scripts/require-pnpm.mjs && vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
