* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.html text eol=lf

*.png binary
*.ico binary
*.icns binary

# Valve's Steamworks libraries: byte-for-byte as the SDK ships them.
vendor/steamworks/*/* binary
# The fork keeps its own README; an upstream change to it never overrides it on
# merge. Needs `git config merge.ours.driver true` once per clone.
README.md merge=ours
